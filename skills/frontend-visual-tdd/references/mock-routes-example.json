[
  {
    "_comment": "Successful user fetch",
    "pattern": "**/api/users/1",
    "response": { "id": 1, "name": "Jane Doe", "role": "admin" }
  },
  {
    "_comment": "Paginated list",
    "pattern": "**/api/posts*",
    "response": {
      "items": [
        { "id": 1, "title": "Hello World" },
        { "id": 2, "title": "Second Post" }
      ],
      "total": 2
    }
  },
  {
    "_comment": "Auth error — test 401 UI state",
    "pattern": "**/api/me",
    "status": 401,
    "response": { "error": "Unauthorized" }
  },
  {
    "_comment": "Network failure — test error boundary",
    "pattern": "**/api/fragile",
    "abort": true
  },
  {
    "_comment": "Custom content type",
    "pattern": "**/api/export",
    "status": 200,
    "contentType": "text/csv",
    "body": "id,name\n1,Jane"
  }
]
